# ============================================
# Backend Environment Variables
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# ============================================
# DEPLOYMENT URLs (Hugging Face Spaces)
# For local dev, change BACKEND_URL and MCP_BACKEND_URL to port 8000
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:7860

# ============================================
# PRODUCTION URLs (Railway)
# Set these in Railway Dashboard > Variables:
# ============================================
# FRONTEND_URL=https://hackathon-todo-orcin.vercel.app
# BACKEND_URL=https://web-production-3e6df.up.railway.app

# OAuth - Google (https://console.developers.google.com)
# Add these redirect URIs in Google Console:
# - http://localhost:8000/api/auth/google/callback (dev)
# - https://web-production-3e6df.up.railway.app/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - GitHub (https://github.com/settings/developers)
# Add these callback URLs in GitHub:
# - http://localhost:8000/api/auth/github/callback (dev)
# - https://web-production-3e6df.up.railway.app/api/auth/github/callback (prod)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Phase III: AI Chatbot with MCP Integration
# ============================================

# OpenAI API (https://platform.openai.com/api-keys)
# Required for the AI chat assistant
OPENAI_API_KEY=sk-your-openai-api-key-here

# MCP Server Configuration
# Port for the MCP server (default: 8001)
MCP_SERVER_PORT=8001

# Backend URL for MCP server to call
# HF Spaces / Docker: http://localhost:7860 (internal communication)
# Local dev: http://localhost:8000 (if running backend and MCP separately)
MCP_BACKEND_URL=http://localhost:7860
